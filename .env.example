# Copy to .env; never commit real secrets. Existing environment values take precedence.
MIYAGI_CLOUD_PROVIDER=gemini
MIYAGI_CLOUD_AUTH=api_key
MIYAGI_GEMINI_MODEL=gemini-3.8-flash
MIYAGI_OPENAI_MODEL=gpt-6-luna
MIYAGI_ANTHROPIC_MODEL=claude-haiku-5-5
# Vertex model IDs can differ from direct API IDs.
MIYAGI_ANTHROPIC_VERTEX_MODEL=claude-haiku-5-5
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# For Vertex ADC: gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# For Gemini on Vertex express mode (separate from Gemini Developer API keys):
VERTEX_API_KEY=
MIYAGI_MODEL_DIR=models
# Optional trained temporal classifier; install with uv sync --extra onnx.
MIYAGI_ONNX_MODEL=
